POSTGRES_DB=allyai
POSTGRES_USER=allyai
POSTGRES_PASSWORD=allyai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# NVIDIA NIM API
NVIDIA_API_KEY=nvapi-...
# Default 8B is ~5-10x faster than 70B on the free NIM endpoint.
# Switch to meta/llama-3.1-70b-instruct if you have paid quota and want richer replies.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
